{
  "name": "kasircashlessskanilan",
  "version": "1.0.0",
  "description": "Sistem kasir berbasis RFID untuk kantin sekolah menggunakan: - **Backend**: Laravel 11 + Filament v3 + Laravel Reverb (WebSocket) - **Database**: PostgreSQL (Supabase untuk dev, VPS untuk prod) - **Hardware**: ESP8266 NodeMCU v3 + RFID RC522 + LCD I2C Qapass + Buzzer - **Auth**: Spatie Laravel-permission (Admin & Kasir roles)",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:admin": "cypress run --spec \"cypress/e2e/admin-flow.cy.js\"",
    "cypress:run:kasir": "cypress run --spec \"cypress/e2e/kasir-flow.cy.js\"",
    "cypress:run:console": "cypress run --spec \"cypress/e2e/console-flow.cy.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghaniyfadhila-source/kasir-skanilan3.git"
