# Dependencies
/node_modules
/backend/node_modules
/backend/vendor
/vendor

# Environment / secrets
.env
.env.local
.env.*.local
/backend/.env
/backend/.env.backup
*.key

# Laravel runtime
/backend/storage/*.key
# bootstrap/cache and the storage/* directories carry their own .gitignore
# placeholders ("*" + "!.gitignore"). Ignoring those directories from here
# instead would drop them from the checkout entirely, and a missing
# bootstrap/cache makes `composer install` fail in package:discover.

# Published vendor assets (generated by `php artisan filament:assets`)
/backend/public/css
/backend/public/js
/backend/public/mix-manifest.json

# Build output
/backend/public/hot
# Note: /backend/public/build is committed on purpose. CI does not run
# `npm run build`, and the login/POS pages must be styled straight after a clone.

# Testing
/coverage
/backend/.phpunit.cache
/backend/.phpunit.result.cache
/backend/phpunit.xml.bak

# Cypress
/cypress/screenshots
/cypress/videos
/cypress/downloads

# Working notes (kept on disk, not part of the deliverable)
/.scratch

# Tooling
.DS_Store
Thumbs.db
.idea
.vscode
*.swp