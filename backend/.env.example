APP_NAME="Kasir Cashless Skanilan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kasir_skanilan
DB_USERNAME=postgres
DB_PASSWORD=

# For hosted Postgres (Supabase, Neon, ...) set a single connection URL
# instead of the DB_* values above. Leave this commented out: while
# DATABASE_URL is set it overrides every DB_* entry, which silently pointed
# CI at a non-existent host.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Supabase (optional - for storage only)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=your-anon-key

# Laravel Reverb (WebSocket)
REVERB_APP_ID=1
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Broadcasting
BROADCAST_DRIVER=reverb

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Cache
# Portable defaults so a fresh checkout runs without extra services; switch to
# redis in production once a Redis server is actually available.
CACHE_DRIVER=file
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Queue
QUEUE_CONNECTION=sync

# Mail (configure for production)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Vite
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"