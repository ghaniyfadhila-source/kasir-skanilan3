{
    "name": "kasir-skanilan/backend",
    "type": "project",
    "description": "Kasir Cashless RFID - Laravel 11 Backend",
    "keywords": ["laravel", "rfid", "pos", "kasir"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "laravel/reverb": "^1.0",
        "spatie/laravel-permission": "^6.0",
        "filament/filament": "^3.2",
        "livewire/livewire": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.0",
        "laravel/tinker": "^3.0",
        "mockery/mockery": "^1.5",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "pest",
        "lint": "pint --test"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "policy.advisories.block": false,
        "policy.advisories.ignore-id": [
            "PKSA-d5tc-s1qs-h781",
            "PKSA-m5cs-t1y6-qpcs",
            "PKSA-3r5d-mb8f-1qw9",
            "PKSA-mdq4-51ck-6kdq",
            "PKSA-8qx3-n5y5-vvnd",
            "PKSA-q46n-4fdk-zjr4",
            "PKSA-qzrn-rnz3-85w1",
            "PKSA-w7xr-vk7n-rstm"
        ],
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
